<?php

namespace {{ MODULE_NAMESPACE }}\Services;

use Illuminate\Contracts\Pagination\LengthAwarePaginator;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use JangKeyte\Services\FileUploadService;
use {{ MODULE_NAMESPACE }}\Filters\{{ MODEL_NAME }}Filter;
use {{ MODULE_NAMESPACE }}\Repositories\{{ MODEL_NAME }}\{{ MODEL_NAME }}RepositoryInterface;{{ SERVICE_IMPORTS }}

class {{ MODEL_NAME }}Service
{
    /**
     * @var array<int, string>
     */
    protected array $with = [{{ WITH_RELATIONS_ARRAY }}];

    /**
     * @var array<int, string>
     */
    protected array $fileFields = [{{ FILE_FIELDS_ARRAY }}];

    /**
     * @var array<int, string>
     */
    protected array $booleanFields = [{{ BOOLEAN_FIELDS_ARRAY }}];

    public function __construct(
        protected {{ MODEL_NAME }}RepositoryInterface $repository,
        protected FileUploadService $fileUploadService,
    ) {}

    public function paginate(Request $request, int $perPage = 15): LengthAwarePaginator
    {
        $filter = $request->filled('keyword') ? new {{ MODEL_NAME }}Filter($request) : null;
        $rawSort = $request->query('sort');
        $sortBy = is_string($rawSort) ? $rawSort : null;
        $rawDir = $request->query('direction', 'desc');
        $sortDir = is_string($rawDir) ? $rawDir : 'desc';
        $onlyTrashed = $request->boolean('trashed');

        return $this->repository->paginateFiltered($filter, $perPage, $sortBy, $sortDir, $onlyTrashed, $this->with);
    }

    public function findOrNew(int|string|null $id): Model
    {
        return $this->repository->find($id);
    }

    public function findOrFail(int|string $id): Model
    {
        return $this->repository->findOrFail($id);
    }

    /**
     * @return array<string, array<int|string, string>>
     */
    public function getRelationOptions(): array
    {
        {{ RELATION_OPTIONS_BODY }}
    }

    public function store(array $validated, Request $request): Model
    {
        $payload = $this->preparePayload($validated, $request);

        return DB::transaction(fn () => $this->repository->create($payload));
    }

    public function update(int|string $id, array $validated, Request $request): Model
    {
        $existing = $this->repository->findOrFail($id);
        $payload = $this->preparePayload($validated, $request, $existing);

        return DB::transaction(fn () => $this->repository->update($id, $payload));
    }

    public function delete(int|string $id): bool
    {
        return DB::transaction(fn (): bool => $this->repository->delete($id));
    }

    /**
     * @param  array<int, int|string>  $ids
     */
    public function bulkDelete(array $ids): int
    {
        return DB::transaction(fn (): int => $this->repository->bulkDelete($ids));
    }{{ SOFT_DELETE_SERVICE_METHODS }}{{ EXPORT_METHOD }}

    protected function preparePayload(array $validated, Request $request, ?Model $existing = null): array
    {
        foreach ($this->booleanFields as $boolField) {
            $validated[$boolField] = $request->boolean($boolField);
        }

        foreach ($this->fileFields as $fileField) {
            $mediaPathKey = $fileField . '_media_path';
            $pickedPath = $validated[$mediaPathKey] ?? $request->input($mediaPathKey);
            unset($validated[$mediaPathKey]);

            if ($request->hasFile($fileField)) {
                $validated[$fileField] = $this->fileUploadService->storeMediaUpload(
                    $request->file($fileField),
                    '{{ TABLE_NAME }}'
                );
            } elseif (is_string($pickedPath) && trim($pickedPath) !== '') {
                $validated[$fileField] = ltrim(str_replace('\\', '/', trim($pickedPath)), '/');
            } else {
                unset($validated[$fileField]);
            }
        }

        return $validated;
    }
}
