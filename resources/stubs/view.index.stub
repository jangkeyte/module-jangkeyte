@push('scripts')
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const selectAll = document.querySelector('.js-select-all-{{ MODEL_SNAKE }}');
        const bulkBtn = document.getElementById('bulkDeleteBtn-{{ MODEL_SNAKE }}');
        const checkboxes = Array.from(document.querySelectorAll('.js-row-check-{{ MODEL_SNAKE }}'));

        if (!bulkBtn || checkboxes.length === 0) {
            return;
        }

        const syncBulkState = function () {
            const checkedCount = checkboxes.filter(function (cb) {
                return cb.checked;
            }).length;

            bulkBtn.disabled = checkedCount === 0;
            if (selectAll) {
                selectAll.checked = checkedCount === checkboxes.length;
                selectAll.indeterminate = checkedCount > 0 && checkedCount < checkboxes.length;
            }
        };

        if (selectAll) {
            selectAll.addEventListener('change', function () {
                checkboxes.forEach(function (cb) {
                    cb.checked = selectAll.checked;
                });
                syncBulkState();
            });
        }

        checkboxes.forEach(function (cb) {
            cb.addEventListener('change', syncBulkState);
        });
    });
</script>
@endpush
