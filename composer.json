{
    "name": "jangkeyte/jangkeyte",
    "description": "Modular Admin Core, RBAC, Visual Module & CRUD Studio, Site Settings & Media Manager for Laravel 11+",
    "type": "library",
    "keywords": [
        "laravel",
        "modular",
        "crud-generator",
        "module-studio",
        "cms",
        "media-manager",
        "site-settings",
        "rbac",
        "authentication",
        "adminlte",
        "jangkeyte"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jang Keyte",
            "email": "jangkeyte@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "spatie/laravel-html": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "JangKeyte\\": "src/",
            "JangKeyte\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "helpers/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "JangKeyte\\Providers\\JangKeyteServiceProvider"
            ]
        },
        "jangkeyte": {
            "version": "2.1.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
